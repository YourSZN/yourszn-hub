# ─────────────────────────────────────────────────────────
# YourSZN Hub — Environment Variables
# Copy this file to .env.local for local dev (never commit .env.local)
# Add these in Vercel: Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────

# A long random secret shared between the frontend (localStorage) and the API.
# Generate one with: openssl rand -hex 32
YSZN_API_SECRET=replace_with_a_long_random_string

# ── Email (Resend) ────────────────────────────────────────
# Sign up at https://resend.com → create an API key
# Verify your sending domain (yourszn.com.au) in Resend → Domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=YourSZN <hello@yourszn.com.au>

# ── SMS (Twilio) ──────────────────────────────────────────
# Sign up at https://twilio.com → get Account SID and Auth Token from Console
# Purchase an Australian number and enable SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+61400000000
